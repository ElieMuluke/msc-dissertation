# Backend configuration. Copy to `.env` and edit; values here override in-code defaults.
# Precedence: real shell env > .env > code default. Anything left unset uses the default.

# --- Generation LLM (Ollama) ---
OLLAMA_MODEL=llama3.2:3b              # answer generator (must be pulled in Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PREDICT=2048               # max output tokens; reasoning models need headroom for the <think> trace too
OLLAMA_REASONING=false              # emit <think> trace (1/true/yes to enable)

# --- RAGAS evaluation ---
RAGAS_JUDGE_MODEL=qwen2.5:3b        # LLM judge; keep a different family than OLLAMA_MODEL
