# Backend configuration. Copy to `.env` and edit; values here override in-code defaults.
# Precedence: real shell env > .env > code default. Anything left unset uses the default.

# --- RAG retrieval (embeddings/chunking) ---
# Production config adopted 2026-07-17 from the 24-run chunker x bm25 x embedder sweep
# (see docs/evaluation.md): section chunker + parent-context + bge-small-en-v1.5, collection
# aml_sections_c, hybrid bm25_weight in the 0.2-0.4 band (0.2 and 0.4 were statistically
# indistinguishable on context_precision; 0.4 chosen for its edge on context_recall — see
# the sweep report for context_precision/recall by weight).
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # sentence-transformers model id; section chunking
                                        # auto-scales to this model's token window.
                                        # GenerationConfig's SCOPE_GATE_THRESHOLD default
                                        # auto-selects per this value (see SCOPE_GATE_THRESHOLD
                                        # below) for calibrated embedders; an embedder not yet
                                        # calibrated falls back to the all-MiniLM-L6-v2 value.
RAG_CHUNKER=section            # fixed = per-page + character windows; section = structure-aware
RAG_PARENT_CONTEXT=true        # with RAG_CHUNKER=section: prefix chunks with doc title + heading
RAG_COLLECTION_NAME=aml_sections_c  # Chroma collection consulted by app.deps (must match the
                                     # embedding model above, or queries silently misalign).
RAG_BM25_WEIGHT=0.4             # hybrid fusion weight (0 = pure vector, 1 = pure BM25);
                                 # only app.deps reads this env var (RagConfig's own default
                                 # is not env-tunable — pass bm25_weight explicitly elsewhere).
# SCOPE_GATE_THRESHOLD=0.638   # auto-selects 0.46 (all-MiniLM-L6-v2) / 0.638 (bge-small-en-v1.5)
                                # based on RAG_EMBEDDING_MODEL when unset. Uncomment to pin an
                                # explicit value instead (always overrides the per-embedder default).

# --- Generation LLM (Ollama) ---
OLLAMA_MODEL=llama3.2:3b              # answer generator (must be pulled in Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PREDICT=2048               # max output tokens; reasoning models need headroom for the <think> trace too
OLLAMA_REASONING=false              # emit <think> trace (1/true/yes to enable)

# --- RAGAS evaluation ---
RAGAS_JUDGE_MODEL=qwen2.5:3b        # LLM judge; keep a different family than OLLAMA_MODEL

# --- Case analysis pipeline (PRD-B, shared agent modules) ---
ANALYSIS_PIPELINE=mas               # default = experiment winner (pre-registered Tier-1, 2026-08-11). Per-request override via
                                    # POST /api/analysis {"pipeline": ...}. After the PRD-A
                                    # analysis (Tue 11 Aug) set this to the experiment winner.
ANALYSIS_MODEL=qwen3.5:9b           # analysis LLM (must be pulled on the analysis server).
                                    # The report pins its sha256 digest at analysis time.
ANALYSIS_OLLAMA_URL=http://localhost:11434
                                    # Analysis Ollama server. SWEEP RULE (PRD-A): the sweep
                                    # servers (:11437 arm A, :11435 arm B — arm A moved off
                                    # :11434 on 2026-08-06, see experiments/CHANGELOG.md)
                                    # take runner traffic exclusively. Analysis/dev traffic
                                    # stays on the systemd server at :11434, which is NOT a
                                    # sweep server. Wall-clock stays indicative only; tokens
                                    # are the primary cost metric.
# ANALYSIS_TEMPERATURE=0.0          # sampling temperature for production analyses.
                                    # Generation params (think:false, num_ctx=16384,
                                    # num_predict=2048) are pinned in code to match the
                                    # measured experiment configuration.
