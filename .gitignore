# Tabular AML dataset: local SQLite store (grows unbounded with real ingestion) and the
# raw HI-Large source files (up to 17GB) — never belong in git history.
backend/tabular_data_db.sqlite
backend/tabular_data_db.sqlite-wal
backend/tabular_data_db.sqlite-shm
backend/tabular_data_db.backup-*.sqlite
backend/data/HI-Large_*.csv
backend/data/HI-Large_*.txt
backend/data/reports/

# Watchlist store: small SQLite rebuilt from backend/data/watchlists/ by
# `python -m app.ingestion.watchlists.ingest` — derived data, not source.
backend/watchlists_db.sqlite
backend/watchlists_db.sqlite.building

# runner logs are run-specific operational noise, never part of the record
backend/experiments/results*/runner-*.log
backend/experiments/results*/**/runner-*.log
